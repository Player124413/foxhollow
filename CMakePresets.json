{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "android-base",
      "hidden": true,
      "generator": "Ninja",
      "toolchainFile": "$env{ANDROID_NDK_ROOT}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ANDROID_PLATFORM": "android-28",
        "ANDROID_STL": "c++_shared",
        "AURORA_SDL3_PROVIDER": "vendor",
        "AURORA_DAWN_PROVIDER": "vendor",
        "AURORA_DAWN_LINKAGE": "static",
        "AURORA_NOD_PROVIDER": "vendor",
        "AURORA_NOD_LINKAGE": "static",
        "FOXHOLLOW_DEBUG_SHORTCUTS": "OFF",
        "FOXHOLLOW_ENABLE_NETWORK": "OFF",
        "CMAKE_DISABLE_FIND_PACKAGE_PkgConfig": "ON",
        "BUILD_SHARED_LIBS": "OFF",
        "BOREALIS_ENABLE_CLI": "OFF",
        "BOREALIS_ENABLE_HTTP": "OFF",
        "BOREALIS_ENABLE_UPDATE": "OFF",
        "AURORA_ENABLE_TESTS": "OFF",
        "BOREALIS_BUILD_TESTS": "OFF",
        "ANDROID_SUPPORT_FLEXIBLE_PAGE_SIZES": "ON"
      }
    },
    {
      "name": "android-arm64",
      "inherits": "android-base",
      "binaryDir": "${sourceDir}/build-android-arm64",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a",
        "AURORA_DAWN_PROVIDER": "package"
      }
    },
    {
      "name": "android-x86_64",
      "inherits": "android-base",
      "binaryDir": "${sourceDir}/build-android-x86_64",
      "cacheVariables": {
        "ANDROID_ABI": "x86_64"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "android-arm64",
      "configurePreset": "android-arm64",
      "targets": [
        "foxhollow"
      ]
    },
    {
      "name": "android-x86_64",
      "configurePreset": "android-x86_64",
      "targets": [
        "foxhollow"
      ]
    }
  ]
}
